{
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "codexQuota": true,
      "colorSource": "theme",
      "borderColorMode": "adaptive",
      "modelLabel": "name",
      "viewportIndicators": true,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)(  $codex_quota)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "pathDisplay": "full",
          "contextFormat": "percent-total",
          "contextGauge": true,
          "showSessionName": true,
          "showTimer": true,
          "showCost": true,
          "showCacheHit": true,
          "showGit": true,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          }
        }
      }
    },
    "footer": {
      "style": "hidden",
      "codexQuota": true,
      "colorSource": "terminal",
      "modelLabel": "name",
      "styles": {
        "starship": {
          "format": "",
          "responsive": true,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens$wrap_sep($codex_quota)",
          "compactMaxLines": 2,
          "separator": "dot",
          "contextStyle": "text+gauge",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "full",
            "depth": 5
          },
          "segments": {
            "cwd": true,
            "sessionName": true,
            "gitBranch": true,
            "gitStatus": true,
            "gitCounts": false,
            "gitCommit": false,
            "gitMetrics": false,
            "runtime": true,
            "modelInfo": true,
            "context": true,
            "tokens": true,
            "cost": true,
            "sessionDuration": false,
            "username": true,
            "time": true,
            "os": false,
            "packageVersion": true
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": true
          },
          "gitMetrics": {
            "onlyNonzero": true,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "middle",
            "placements": {},
            "colorModes": {}
          }
        }
      }
    },
    "userMessages": {
      "enabled": true,
      "style": "labeled",
      "colorSource": "theme",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      },
      "colors": {}
    },
    "selectorBorders": {
      "enabled": true,
      "style": "zentui",
      "colorSource": "theme"
    },
    "thinkingSteps": {
      "enabled": false,
      "mode": "streaming"
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": false,
      "spinner": "star-bloom",
      "spinnerIntervalMs": 160,
      "animateSpinnerColor": true,
      "textIntervalMs": 60,
      "textAnimation": "kitt",
      "colorSource": "theme",
      "messages": {
        "custom": true,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tool": false,
        "elapsed": false,
        "thought": false,
        "tokens": false
      }
    },
    "extensionStatuses": {
      "defaultVisibility": "hide",
      "hidden": {
        "defaultPlacement": "right"
      }
    }
  },
  "icons": {
    "mode": "nerd"
  }
}
