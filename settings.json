{
  "lastChangelogVersion": "0.87.1",
  "theme": "pi-dark",
  "defaultProvider": "antigravity",
  "defaultModel": "gemini-3.8-flash",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-antigravity",
    "npm:@sfroment/pi-gh-cli",
    "npm:pi-context-view",
    "npm:pi-better-edit",
    "npm:@pi-kaush/pi-welcome-screen",
    "npm:@petechu/pi-extension-toggle",
    "npm:pi-zentui",
    "npm:@bacnh85/pi-themes"
  ],
  "compaction": {
    "enabled": true
  },
  "tuiMode": "fullscreen",
  "enabledModels": [
    "antigravity/gemini-3.8-flash",
    "antigravity/claude-opus-4-6",
