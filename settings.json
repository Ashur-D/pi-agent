{
  "lastChangelogVersion": "1.4.0",
  "theme": "pi-dark",
  "packages": [
    "npm:pi-web-access",
    "npm:@sfroment/pi-gh-cli",
    "npm:pi-context-view",
    "npm:pi-better-edit",
    "npm:pi-zentui"
  ],
  "compaction": {
    "enabled": true
  },
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "images": {
    "autoResize": true
  },
  "treeFilterMode": "no-tools",
  "terminal": {
    "imageWidthCells": 60,
    "showTerminalProgress": false
  },
  "editorPaddingX": 0,
  "outputPad": 1,
  "enableInstallTelemetry": false,
  "doubleEscapeAction": "none",
  "quietStartup": true,
  "steeringMode": "all"
}